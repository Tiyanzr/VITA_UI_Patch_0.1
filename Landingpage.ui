      <property name="styleSheet">
       <string notr="true">QPushButton {
    background-color: transparent; /* Tombol tidak terlihat wujudnya, jadi gambar dari Figma tampil utuh */
    border: none;
    border-radius: 30px; /* Menyamakan kelengkungan sudut 30px persis seperti di Figma */
}
QPushButton:hover {
    background-color: rgba(255, 255, 255, 30); /* Memberikan sedikit kilau putih transparan saat kursor melintas di atasnya */
    border-radius: 30px;
}
QPushButton:pressed {
    background-color: rgba(0, 0, 0, 45); /* Efek gelap transparan yang aktif seketika saat tombol diklik (efek 'genuine' tertekan) */
    border-radius: 30px;
}</string>
      </property>
      <property name="text">
       <string/>
      </property>
     </widget>
    </widget>
