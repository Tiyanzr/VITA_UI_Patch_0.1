    color: transparent; /* label scenario sudah tercetak di gambar background */
}
QRadioButton#radioButton_1::indicator,
QRadioButton#radioButton_2::indicator,
QRadioButton#radioButton_3::indicator,
QRadioButton#radioButton_4::indicator,
QRadioButton#radioButton_5::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #B8C4D6;
    border-radius: 8px;
    background-color: #FFFFFF;
}
QRadioButton#radioButton_1::indicator:checked,
QRadioButton#radioButton_2::indicator:checked,
QRadioButton#radioButton_3::indicator:checked,
QRadioButton#radioButton_4::indicator:checked,
QRadioButton#radioButton_5::indicator:checked {
    border: 1px solid #1565D8;
    border-radius: 8px;
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
        stop:0 #1565D8, stop:0.35 #1565D8, stop:0.4 #FFFFFF, stop:1 #FFFFFF);
}</string>
      </property>
      <property name="text">
       <string>Custom Scenario</string>
      </property>
     </widget>
    </widget>
